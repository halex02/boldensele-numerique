         <text:p text:style-name="amh_5f_note_5f_apparat"><text:span text:style-name="amh_5f_apparat_5f_lemme">et strictum quod quidem de Marroch uulgariter uocatur</text:span><text:span text:style-name="T193"> </text:span><text:span text:style-name="amh_5f_apparat_5f_témoin">Li</text:span><text:span text:style-name="T193"> : </text:span><text:span text:style-name="amh_5f_apparat_5f_variante">strictum de Maroch</text:span><text:span text:style-name="T193"> </text:span><text:span text:style-name="amh_5f_apparat_5f_témoin">U</text:span><text:span text:style-name="T193"> | </text:span><text:span text:style-name="amh_5f_apparat_5f_variante">et strictum de Marroch quod uulgariter dicitur</text:span><text:span text:style-name="T193"> </text:span><text:span text:style-name="amh_5f_apparat_5f_témoin">Wo</text:span><text:span text:style-name="T193"> </text:span><text:span text:style-name="T194">| </text:span><text:span text:style-name="amh_5f_apparat_5f_variante">et strictum de Maroch uulgariter dicitur</text:span><text:span text:style-name="T194"> </text:span><text:span text:style-name="amh_5f_apparat_5f_témoin">Deluz</text:span></text:p></text:note-body></text:note></text:span></text:span><text:span text:style-name="T174">, </text:span><text:span text:style-name="amh_5f_ancre_5f_glossaire">Continuo</text:span><text:span text:style-name="T174">continuatur hoc </text:span><text:span text:style-name="amh_5f_ancre_5f_glossaire">Mare</text:span><text:span text:style-name="T174">mare </text:span><text:span text:style-name="amh_5f_ancre_5f_index_5f_locorum"><text:span text:style-name="T174">Meditteraneum </text:span></text:span><text:span text:style-name="amh_5f_ancre_5f_index_5f_locorum"><text:span text:style-name="T180">(mare)</text:span></text:span><text:span text:style-name="T195">M</text:span><text:span text:style-name="T174">editerraneum cum </text:span><text:span text:style-name="amh_5f_ancre_5f_index_5f_locorum"><text:span text:style-name="T174">Occeanus</text:span></text