       <text:p text:style-name="amh_5f_note_5f_apparat"><text:span text:style-name="amh_5f_apparat_5f_lemme">beatus uenter qui te portauit et ubera que suxisti</text:span> <text:span text:style-name="amh_5f_apparat_5f_commentaire"><text:span text:style-name="T296">(</text:span></text:span><text:span text:style-name="amh_5f_apparat_5f_commentaire">Lc. 11,27</text:span><text:span text:style-name="amh_5f_apparat_5f_commentaire"><text:span text:style-name="T296">)</text:span></text:span></text:p></text:note-body></text:note><text:span text:style-name="T295">.</text:span></text:p>
